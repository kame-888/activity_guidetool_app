<header class="navbar navbar-dark bg-dark">
  <%= link_to "ACT予約", root_path %>

  <nav class="navbar navbar-expand bg-light border-bottom">
    <div class="container">
      <%= link_to "ガイドツール", root_path, class: "navbar-brand" %>
      <% if user_signed_in? %>
        <div class="d-flex align-items-center">
          <span class="me-3 small text-muted"><%= current_user.full_name %></span>
          <%= link_to "お気に入り", favorites_path, class: "btn btn-outline-secondary btn-sm me-2" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                class: "btn btn-outline-secondary btn-sm" %>
        </div>
      <% else %>
        <div class="d-flex align-items-center">
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-secondary btn-sm me-2" %>
          <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </nav>
</header>