<header>
  <nav class="navbar bg-dark navbar-dark shadow-sm">
    <div class="container">
      <%= link_to root_path, class: "navbar-brand fw-bold" do %>
        🧭 ガイドツール
      <% end %>

      <% if user_signed_in? %>
        <div class="d-flex align-items-center gap-2">
          <%= link_to edit_user_registration_path,
              class: "d-flex align-items-center gap-2 text-white-50 small text-decoration-none",
              title: "ユーザー情報を編集" do %>

            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar,
                  class: "rounded-circle border border-secondary object-fit-cover",
                  style: "width: 36px; height: 36px;",
                  alt: "アイコン" %>
            <% else %>
              <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center fw-bold"
                  style="width: 36px; height: 36px;">
                <%= current_user.last_name.to_s.first %>
              </span>
            <% end %>

            <span class="d-none d-sm-inline">
              <%= current_user.full_name %>
              <span class="badge bg-secondary ms-1"><%= User.human_attribute_name("role.#{current_user.role}") %></span>
            </span>
          <% end %>

          <%= link_to "お気に入り", favorites_path, class: "btn btn-outline-light btn-sm" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
              class: "btn btn-light btn-sm" %>
        </div>
      <% else %>
        <div class="d-flex align-items-center gap-2">
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-light btn-sm" %>
          <%= link_to "新規登録", new_user_registration_path, class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </nav>
</header>