<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center">
          <h1 class="h4 mb-0">ログイン</h1>
        </div>

        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, "メール", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "Eメール", autofocus: true, autocomplete: "email" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "パスワード", class: "form-label" %>
              <%= f.password_field :password, class: "form-control", placeholder: "パスワード", autocomplete: "current-password" %>
            </div>

            <div class="d-grid mb-3">
              <%= f.submit "ログイン", class: "btn btn-primary" %>
            </div>
          <% end %>

          <div class="text-center">
            <a href="#">パスワードを忘れた？</a>
          </div>
        </div>

        <div class="card-footer text-center bg-white">
          アカウントを持っていない？
          <%= link_to "サインアップ", new_user_registration_path %>
        </div>
      </div>
    </div>
  </div>
</div>