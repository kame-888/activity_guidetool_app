<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center">
          <h1 class="h4 mb-0">サインアップ</h1>
        </div>

        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= f.label :last_name, "苗字", class: "form-label" %>
                <%= f.text_field :last_name, class: "form-control", placeholder: "苗字" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.label :first_name, "名前", class: "form-label" %>
                <%= f.text_field :first_name, class: "form-control", placeholder: "名前" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :email, "メール", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "Eメール", autocomplete: "email" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "パスワード", class: "form-label" %>
              <%= f.password_field :password, class: "form-control", placeholder: "パスワード", autocomplete: "new-password" %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-control", placeholder: "パスワード確認", autocomplete: "new-password" %>
            </div>

            <div class="mb-4">
              <%= f.label :avatar, "アイコン用画像", class: "form-label" %>
              <%= f.file_field :avatar, class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= f.submit "サインアップ", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>

        <div class="card-footer text-center bg-white">
          すでにアカウントをお持ちですか？
          <%= link_to "ログイン", new_user_session_path %>
        </div>
      </div>
    </div>
  </div>
</div>