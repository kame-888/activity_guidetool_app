<h1 class="h3"><%= @activity.title %></h1>
<%= render "favorites/button", activity: @activity, favorited: current_user.favorite_activities.exists?(@activity.id) %>
<p>
  <span class="badge bg-secondary"><%= Activity.human_attribute_name("genre.#{@activity.genre}") %></span>
  所要時間 <%= @activity.duration_minutes %>分
</p>

<div class="d-flex justify-content-between align-items-center mt-4">
  <h2 class="h5 mb-0">開催枠</h2>
  <% if current_user.manager? %>
    <%= link_to "開催枠を追加", new_activity_time_slot_path(@activity), class: "btn btn-sm btn-primary" %>
  <% end %>
</div>

<div class="list-group mt-2">
  <% @time_slots.each do |slot| %>
    <%= link_to time_slot_path(slot), class: "list-group-item list-group-item-action d-flex justify-content-between" do %>
      <span>
        <%= l slot.starts_at, format: :short %> 〜 <%= l slot.ends_at, format: :short %>
        <small class="text-muted ms-2">担当 <%= slot.guide&.full_name || "未割り当て" %></small>
      </span>
      <span class="badge <%= slot.cancelled? ? 'bg-danger' : 'bg-success' %>">
        <%= TimeSlot.human_attribute_name("status.#{slot.status}") %>
      </span>
    <% end %>
  <% end %>
  <% if @time_slots.empty? %>
    <div class="list-group-item text-muted">開催枠はまだありません</div>
  <% end %>
</div>

<% if current_user.manager? %>
  <div class="d-flex gap-2 mt-4">
    <%= link_to "編集", edit_activity_path(@activity), class: "btn btn-outline-primary" %>
    <%= button_to "削除", @activity, method: :delete,
          class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "本当に削除しますか?" } } %>
  </div>
<% end %>
<%= link_to "一覧へ戻る", activities_path, class: "d-block mt-3" %>