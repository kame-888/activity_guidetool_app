<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">アクティビティ一覧</h1>
  <% if current_user.manager? %>
    <%= link_to "新規登録", new_activity_path, class: "btn btn-primary" %>
  <% end %>
</div>

<div class="list-group">
  <% @activities.each do |activity| %>
    <%= link_to activity, class: "list-group-item list-group-item-action" do %>
      <div class="d-flex justify-content-between">
        <strong><%= activity.title %></strong>
        <span class="badge bg-secondary"><%= Activity.human_attribute_name("genre.#{activity.genre}") %></span>
      </div>
      <small class="text-muted">所要時間 <%= activity.duration_minutes %>分</small>
    <% end %>
  <% end %>
</div>