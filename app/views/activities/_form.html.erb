<%= form_with model: activity do |f| %>
  <% if activity.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% activity.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, "タイトル", class: "form-label" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :genre, "ジャンル", class: "form-label" %>
    <%= f.select :genre,
          Activity.genres.keys.map { |g| [Activity.human_attribute_name("genre.#{g}"), g] },
          {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :duration_minutes, "所要時間(分)", class: "form-label" %>
    <%= f.number_field :duration_minutes, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :guide_id, "担当ガイド", class: "form-label" %>
    <%= f.collection_select :guide_id, User.guide.order(:last_name, :first_name), :id, :full_name,
          { include_blank: "未割り当て" }, class: "form-select" %>
  </div>

  <%= f.submit "保存", class: "btn btn-primary" %>
  <%= link_to "戻る", activities_path, class: "btn btn-outline-secondary" %>
<% end %>