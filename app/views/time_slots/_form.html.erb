<%= form_with model: [activity, time_slot] do |f| %>
  <% if time_slot.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% time_slot.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :starts_at, "開始日時", class: "form-label" %>
    <%= f.datetime_field :starts_at, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :ends_at, "終了日時(空欄なら所要時間から自動計算)", class: "form-label" %>
    <%= f.datetime_field :ends_at, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :status, "状態", class: "form-label" %>
    <%= f.select :status,
          TimeSlot.statuses.keys.map { |s| [TimeSlot.human_attribute_name("status.#{s}"), s] },
          {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :guide_id, "担当ガイド", class: "form-label" %>
    <%= f.collection_select :guide_id, User.guide.order(:last_name, :first_name), :id, :full_name,
          { include_blank: "未割り当て" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :memo, "メモ", class: "form-label" %>
    <%= f.text_area :memo, rows: 3, class: "form-control" %>
  </div>

  <%= f.submit "保存", class: "btn btn-primary" %>
  <%= link_to "戻る", activity, class: "btn btn-outline-secondary" %>
<% end %>