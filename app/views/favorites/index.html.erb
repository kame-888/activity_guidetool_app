<h1 class="h3 mb-4">お気に入り</h1>

<div class="list-group">
  <% @activities.each do |activity| %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <%= link_to activity.title, activity %>
      <%= render "favorites/button", activity: activity, favorited: true %>
    </div>
  <% end %>
  <% if @activities.empty? %>
    <div class="list-group-item text-muted">お気に入りはまだありません</div>
  <% end %>
</div>